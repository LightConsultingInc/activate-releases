# Self-hosted Activate (Compose evaluation). Copy to .env and fill in every line marked required.

# Which release to run (images are signed; see the self-host guide to verify them)
ACTIVATE_VERSION=1.0.5

# Required: the license LightCI sent you (one long line)
ACTIVATE_LICENSE=

# Required: encryption key for credentials stored in the database. Generate once, back it up:  openssl rand -base64 32
ACTIVATE_SECRETS_KEY=

# Required: session cookie key for the web app (32+ random characters)
SESSION_SECRET=

# Required: database password for the bundled Postgres
DB_PASSWORD=

# Where people reach Activate (the web app) and where Claude reaches the connector (the API)
WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8081

# Identity. oidc = your own provider (Okta, Entra ID, Keycloak…); workos = a WorkOS environment you own.
AUTH_PROVIDER=oidc
AUTH_OIDC_ISSUER=https://login.example.com/realms/acme
AUTH_OIDC_CLIENT_ID=activate
AUTH_OIDC_CLIENT_SECRET=
AUTH_GROUPS_CLAIM=groups
# AUTH_ROLE_MAP={"admin":["IT-Admins"],"sponsor":["Activate-Sponsors"],"champion":["Claude-Champions"]}
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# Models
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5
# OPENAI_API_KEY=                 # only for spoken interviews

# Marketplace repository (github or git). Leave local for a quick look around.
LIBRARY_PROVIDER=local
# LIBRARY_REPOSITORY=owner/claude-marketplace
# LIBRARY_GIT_TOKEN=
# LIBRARY_REMOTE_URL=

# First boot: your organisation and the people who administer it
ACTIVATE_ORG_NAME=Example Corp
ACTIVATE_ORG_SLUG=example
ACTIVATE_ORG_EMAIL_DOMAINS=example.com
ACTIVATE_ORG_INITIAL_ADMINS=jane.doe@example.com

WORKER_TIMEZONE=UTC
LOG_LEVEL=info
# API_REPLICAS=1

# Set false on restricted networks: no daily read of
# https://github.com/LightConsultingInc/activate-releases/releases/latest/download/index.json
UPDATE_CHECK_ENABLED=true
